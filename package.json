{
  "name": "slidesmith-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent-friendly React + TypeScript engine for building presentation decks as code.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "export:pdf": "npm run build && node scripts/export-pdf.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
